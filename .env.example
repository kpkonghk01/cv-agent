# ---------------------------------------------------------------------------
# cv-agent configuration (copy to .env). BYOK, OpenAI-compatible — see ADR 0002.
# ---------------------------------------------------------------------------

# --- Default LLM (used by every node unless overridden below) ---------------
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=sk-local
LLM_MODEL=Qwen3.8-27B

# --- Optional model-behaviour knobs (help local / reasoning models) ---
# Cap generation length (a ceiling, not a target). This is OUTPUT tokens only —
# separate from the model's context window. Keep it generous: the interview brief
# is a long document and 4096 may truncate it.
# LLM_MAX_TOKENS=8192
# Disable thinking/reasoning mode (Qwen3 etc.) — direct answers, much faster.
# LOCAL ENDPOINTS ONLY: this sends the vLLM/SGLang/MLX-specific
# extra_body.chat_template_kwargs.enable_thinking, which public providers
# (OpenRouter/DeepSeek/OpenAI) don't understand. The client auto-detects a local
# base_url (localhost / loopback / private-LAN / *.local) and only sends it there,
# so leaving this on with a remote provider is a harmless no-op. To constrain a
# REMOTE reasoning model's verbosity, rely on JSON mode instead (already on for the
# structured nodes).
# LLM_DISABLE_THINKING=true

# --- Per-node overrides (ALL optional) --------------------------------------
# There are exactly 4 LLM nodes. Each can override MODEL, BASE_URL, and API_KEY
# independently — e.g. run cheap extraction locally and interview generation on
# a stronger cloud model. Uncomment only what you want to override.
#
# Node 1 — STRUCTURE_CV : Marker markdown -> CandidateProfile JSON
# LLM_MODEL__STRUCTURE_CV=
# LLM_BASE_URL__STRUCTURE_CV=
# LLM_API_KEY__STRUCTURE_CV=
#
# Node 2 — JD_RUBRIC    : JD -> Rubric (requirements + role archetype)
# LLM_MODEL__JD_RUBRIC=
# LLM_BASE_URL__JD_RUBRIC=
# LLM_API_KEY__JD_RUBRIC=
#
# Node 3 — SCREEN       : CandidateProfile + Rubric -> ScreeningReport
# LLM_MODEL__SCREEN=
# LLM_BASE_URL__SCREEN=
# LLM_API_KEY__SCREEN=
#
# Node 4 — INTERVIEW    : -> Interview Brief (for passing candidates)
# LLM_MODEL__INTERVIEW=
# LLM_BASE_URL__INTERVIEW=
# LLM_API_KEY__INTERVIEW=

# --- Sources & sink ---------------------------------------------------------
CV_SOURCE=local              # local | gdrive
CV_SOURCE_DIR=./data/cvs     # used when CV_SOURCE=local
JD_SOURCE_DIR=./data/jds
DEFAULT_JD=ai-app-engineer.md
REPORT_SINK_DIR=./data/reports

# --- Google Drive CV source (used when CV_SOURCE=gdrive) --------------------
# CVs live in date-named subfolders (e.g. /20260818/xxx.pdf) under this folder.
# OAuth read-only as yourself — no folder sharing needed. See vmlx/../README dev notes.
# GDRIVE_FOLDER_ID=1uV2kcX7BnCXwLurOsxePQ5Q8YnQcDGay
# GOOGLE_OAUTH_CLIENT_SECRET=./credentials/client_secret.json
# GOOGLE_OAUTH_TOKEN=./credentials/token.json

# Note: rank-score weights (must_weight / nice_weight, default 2 / 1) are set per JD in
# its <jd>.meta.yaml, not here.

# --- Storage (3-layer cache + registry live in one SQLite file — ADR 0003) --
STORE_PATH=./data/cv_agent.sqlite

# --- Runtime ----------------------------------------------------------------
MAX_CONCURRENCY=1            # sequential first; raise once stable
OCR_CONFIDENCE_THRESHOLD=0.6 # below this => flag for manual review (still screened)
