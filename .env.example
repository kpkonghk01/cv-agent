# ---------------------------------------------------------------------------
# cv-agent configuration (copy to .env). BYOK, OpenAI-compatible — see ADR 0002.
# ---------------------------------------------------------------------------

# --- Default LLM (used by every node unless overridden below) ---------------
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=sk-local
LLM_MODEL=Qwen3.8-27B

# --- Optional model-behaviour knobs (help local / reasoning models) ---
# Cap generation length so a runaway model can't burn the whole budget.
# LLM_MAX_TOKENS=4096
# Disable thinking/reasoning mode (Qwen3 etc.) — direct answers, much faster.
# LLM_DISABLE_THINKING=true

# --- Per-node overrides (ALL optional) --------------------------------------
# There are exactly 4 LLM nodes. Each can override MODEL, BASE_URL, and API_KEY
# independently — e.g. run cheap extraction locally and interview generation on
# a stronger cloud model. Uncomment only what you want to override.
#
# Node 1 — STRUCTURE_CV : Marker markdown -> CandidateProfile JSON
# LLM_MODEL__STRUCTURE_CV=
# LLM_BASE_URL__STRUCTURE_CV=
# LLM_API_KEY__STRUCTURE_CV=
#
# Node 2 — JD_RUBRIC    : JD -> Rubric (requirements + role archetype)
# LLM_MODEL__JD_RUBRIC=
# LLM_BASE_URL__JD_RUBRIC=
# LLM_API_KEY__JD_RUBRIC=
#
# Node 3 — SCREEN       : CandidateProfile + Rubric -> ScreeningReport
# LLM_MODEL__SCREEN=
# LLM_BASE_URL__SCREEN=
# LLM_API_KEY__SCREEN=
#
# Node 4 — INTERVIEW    : -> Interview Brief (for passing candidates)
# LLM_MODEL__INTERVIEW=
# LLM_BASE_URL__INTERVIEW=
# LLM_API_KEY__INTERVIEW=

# --- Sources & sink (folders now; Google Drive later, same ports) -----------
CV_SOURCE_DIR=./data/cvs
JD_SOURCE_DIR=./data/jds
DEFAULT_JD=ai-app-engineer.md
REPORT_SINK_DIR=./data/reports

# --- Storage (3-layer cache + registry live in one SQLite file — ADR 0003) --
STORE_PATH=./data/cv_agent.sqlite

# --- Runtime ----------------------------------------------------------------
MAX_CONCURRENCY=1            # sequential first; raise once stable
OCR_CONFIDENCE_THRESHOLD=0.6 # below this => flag for manual review (still screened)
